{
  "name": "ai-instatoon",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "www.ai-instatoon.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./deploy",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // /api/* 만 Worker가 먼저 받고, 나머지 주소는 지금처럼 정적 에셋이 바로 처리한다.
    "run_worker_first": ["/api/*"]
  },
  // 무료 맛보기 하루 횟수 저장소(입력·결과는 저장하지 않음, IP 해시+날짜별 횟수만)
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "Quota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Quota"] }],
  // IP별 분당 제한
  "ratelimits": [{ "name": "RL", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // 설정값(비밀이 아닌 것). 비밀값(GEMINI_KEY·GROQ_KEY·OPENROUTER_KEY·TURNSTILE_SECRET)은 Cloudflare 화면의 Secret으로만 넣는다.
  "vars": {
    "TASTE_ENABLED": "1",
    "TASTE_MAKE_PER_DAY": "1",
    "TASTE_MONTH_PER_DAY": "1",
    "GEMINI_DAILY_CAP": "400",
    "GROQ_DAILY_CAP": "18",
    "OPENROUTER_DAILY_CAP": "45",
    "MAX_PROMPT_CHARS": "9000",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "OPENROUTER_MODEL": "openrouter/free",
    // Turnstile 사이트 키(공개값). 비워 두면 맛보기가 꺼진 채로 동작한다.
    "TURNSTILE_SITEKEY": ""
  },
  "previews": {}
}
